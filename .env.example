# Local browser configuration. Only these PUBLIC values may use VITE_ prefixes.
VITE_CONVEX_URL=
VITE_GOOGLE_CLIENT_ID=

# Set these in the Convex dashboard, not in browser configuration:
# AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, JWT_PRIVATE_KEY, JWKS, SITE_URL
# ALLOWED_EMAILS: comma-separated exact addresses allowed to run research
# HUNTER_API_KEY: corporate email lookup and verification
# AI_MODEL: e.g. openai/gpt-4.1-mini for the Convex AI Gateway
# OPENAI_API_KEY: optional fallback for free/local deployments without the gateway
# OPENAI_MODEL: model for that fallback; default gpt-4.1-mini
# ENABLE_PAID_WORKFLOWS: false until the owner has reviewed provider charges
